{
  "name": "WHATSAPP-BOT",
  "version": "1.0.0",
  "description": "Bot de WhatsApp otimizado para VPS, Termux, Google Colab e Sandboxes",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --max-old-space-size=512 index.js",
    "dev": "node --watch index.js",
    "pm2": "pm2 start index.js --name whatsapp-bot",
    "colab": "node --no-warnings index.js",
    "termux": "NODE_ENV=production node --max-old-space-size=256 index.js"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "nodejs",
    "termux",
    "vps",
    "colab"
  ],
  "author": "AMHEEX",
  "license": "ISC",
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "jimp": "^0.22.12",
    "node-cache": "^5.1.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.32.6"
  },
  "devDependencies": {
    "pm2": "^5.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
